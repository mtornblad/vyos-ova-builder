[Unit]
Description=Apply VMware vApp properties to VyOS
After=vyos-router.service open-vm-tools.service
Requires=vyos-router.service
Wants=open-vm-tools.service
ConditionPathExists=!/opt/vyos-ova-builder/vapp-configured
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
User=root
Group=vyattacfg
ExecStart=/usr/local/sbin/vyos-vapp-init
TimeoutStartSec=10min
Restart=on-failure
RestartSec=15
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
